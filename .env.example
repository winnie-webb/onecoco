# Copy to .env.local to override. The marketing site (Phase 1) needs only
# NEXT_PUBLIC_SITE_URL; anything touching the database needs the Phase 2
# block below too.

# Canonical origin. Used for metadataBase, robots.txt and sitemap.xml, and
# later for payment return URLs — where getting it wrong fails SILENTLY
# (the customer is redirected to a dead page and capture never runs).
# Verify this explicitly at every go-live. The domain is still undecided.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2. Local dev: `npx supabase start` prints these (also in `npx supabase status`).
# A real project's values come from the Supabase dashboard, never committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only (§16). Never referenced from a Client Component
# or anything in the `NEXT_PUBLIC_*` namespace — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 5. Unset means lib/payments/index.ts's getProvider("paypal") throws
# ProviderNotConfiguredError — the mock provider stays the only one actually
# reachable through checkout until these are real. NOT verified against a
# real PayPal sandbox in this codebase's development environment — see
# PHASE-5-NOTES.md.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live — wrong value here fails SILENTLY (§8, §23). Also gates
# which base URL lib/payments/paypal.ts calls.
PAYPAL_ENVIRONMENT=sandbox
# From the PayPal developer dashboard's webhook subscription — required to
# verify incoming webhook signatures (lib/payments/paypal-webhook.ts).
# §8: "the webhook endpoint must be registered in the provider dashboard
# and verified with a real test event before launch" — blocking, not done.
PAYPAL_WEBHOOK_ID=

# Phase 5. Unset means lib/notifications/transport.ts console-sinks (§22) —
# also NOT verified against a real Resend account; see PHASE-5-NOTES.md.
RESEND_API_KEY=
RESEND_FROM=

# --- Not used yet. Listed so the shape of the system is visible. ---
# Phase 2/4: MAPBOX_TOKEN          (static satellite images, admin zone editor)
# Phase 2: NEXT_PUBLIC_POSTHOG_KEY, NEXT_PUBLIC_POSTHOG_HOST — unset means
#   lib/analytics/events.ts no-ops (no PostHog account yet, §22).
